# Recommended: keep OPENAI_API_KEY in the OS credential store instead of this file:
#   security add-generic-password -s teamlab-openai -a teamlab -w   (macOS Keychain)
# A key in .env still works as a fallback but prints a warning (static key on disk).
# Copy to .env only if you do not already have a configured .env.
# Existing process environment values take precedence. No shell evaluation.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional: uncomment and use a random value of at least 32 characters to serve
# the authenticated read-only monitoring API.
# TEAMLAB_MONITOR_TOKEN=replace-with-a-random-token-at-least-32-characters

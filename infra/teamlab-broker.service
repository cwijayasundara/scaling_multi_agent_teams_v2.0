[Unit]
Description=TeamLab isolated calculation broker
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/teamlab
Environment=PYTHONPATH=/opt/teamlab/src
ExecStart=/usr/bin/python3 -m teamlab.execution --config /etc/teamlab/broker.json
# Includes all jailer/Firecracker descendants on service stop or failure.
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
UMask=0077
TasksMax=256
MemoryMax=6G
RestrictAddressFamilies=AF_UNIX
PrivateTmp=true
# Host hardening must be qualified with the deployed jailer/cgroup setup.
# Do not add provider/database secrets to this service's environment.

[Install]
WantedBy=multi-user.target
